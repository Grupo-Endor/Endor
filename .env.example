# OpenAI — preferido para análisis real; sin ninguna key se usa reporte mock
OPENAI_API_KEY=
# Alias aceptado (misma key OpenAI si la pusiste con este nombre en Vercel)
OPEN_AI_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# OpenRouter — fallback si OpenAI sin créditos / cuota
# En Vercel producción: OPEN_ROUTER_EMILIO
OPEN_ROUTER_EMILIO=
# Alias estándar también aceptado
OPENROUTER_API_KEY=
# Modelo OpenRouter (costo/calidad para JSON diagnóstico ES). Default: openai/gpt-4o-mini
# OPENROUTER_MODEL=openai/gpt-4o-mini


# Supabase — sin estas vars el API guarda en memoria/mock
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (opcional; para bypass RLS al actualizar scores)
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Booking CTA (Google Calendar appointment schedule)
NEXT_PUBLIC_BOOKING_URL=https://calendar.app.google/P3Pi2TQHQ8cSgr6N7

# --- Email del reporte al cliente (solo cuando status=ready) ---
# Preferido: Composio → GMAIL_SEND_EMAIL como herramientas@grupoendor.com
# Cuenta conectada: gmail_moosa-torve
COMPOSIO_API_KEY=
# Opcional override del connected account id
COMPOSIO_GMAIL_ACCOUNT_ID=gmail_moosa-torve
# Alias accepted by send-report-email (same value)
COMPOSIO_CONNECTED_ACCOUNT_ID=gmail_moosa-torve

# Fallback: Resend (si no hay COMPOSIO_API_KEY)
RESEND_API_KEY=
# From para Resend (default onboarding@resend.dev en test)
EMAIL_FROM=Ēndor <herramientas@grupoendor.com>
